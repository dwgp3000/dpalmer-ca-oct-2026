---
interface Props {
	heading: string;
	text?: string;
	paragraphs?: string[];
	buttonText?: string;
	buttonHref?: string;
}

const {
	heading,
	text,
	paragraphs = [],
	buttonText = 'Book a Free Consultation',
	buttonHref = '/contact'
} = Astro.props;
---

<section class="cta-section">
	<div class="container">
		<div class="cta-inner">
			<h2>{heading}</h2>
			{text && <p>{text}</p>}

{paragraphs.map((paragraph) => (
	<p>{paragraph}</p>
))}

			<a class="cta-button" href={buttonHref}>
				{buttonText}
			</a>
		</div>
	</div>
</section>