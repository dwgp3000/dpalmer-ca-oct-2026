---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardGrid from '../components/CardGrid.astro';
import ContentSection from '../components/ContentSection.astro';
import CallToAction from '../components/CallToAction.astro';

import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';

const builder = createImageUrlBuilder(sanityClient);

function urlFor(source) {
	return builder.image(source);
}

const homePage = await sanityClient.fetch(
	`*[_type == "homePage"][0]{
		heroHeading,
		heroParagraphs,
		heroButtonText,
		heroButtonLink,
		heroImage,

		servicesHeading,

		featuredServices[]->{
			title,
			shortDescription,
			"href": "/" + slug.current + "/",
			icon
		},

		contentSections[]{
			heading,
			lead,
			contentType,
			paragraphs,
			items,
			richText,
			showDeliverables,
			closingText
		},

		ctaHeading,
		ctaParagraphs,
		ctaButtonText,

		seo {
			metaTitle,
			metaDescription
		}
	}`
);

const heroImageUrl = homePage.heroImage
	? urlFor(homePage.heroImage)
			.width(650)
			.auto('format')
			.url()
	: '/images/Dave-Palmer-transparent-650p.png';

const services = homePage.featuredServices.map((service) => ({
	title: service.title,
	description: service.shortDescription,
	href: service.href,
	icon: service.icon
}));
---

<Layout
	title={homePage.seo.metaTitle}
	description={homePage.seo.metaDescription}
>
	<Hero
		heading={homePage.heroHeading}
		paragraphs={homePage.heroParagraphs}
		buttonText={homePage.heroButtonText}
		buttonLink={homePage.heroButtonLink}
		image={heroImageUrl}
	/>

	<CardGrid
		heading={homePage.servicesHeading}
		columns={3}
		cards={services}
	/>

	{homePage.contentSections.map((section) => (
		<ContentSection
			heading={section.heading}
			lead={section.lead}
			contentType={section.contentType}
			paragraphs={section.paragraphs}
			items={section.items}
			richText={section.richText}
			closingText={section.closingText}
		/>
	))}

	<CallToAction
		heading={homePage.ctaHeading}
		paragraphs={homePage.ctaParagraphs}
		buttonText={homePage.ctaButtonText}
	/>
</Layout>