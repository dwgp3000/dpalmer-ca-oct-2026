---
import Layout from '../../layouts/Layout.astro';
import BannerHero from '../../components/BannerHero.astro';
import ContentSection from '../../components/ContentSection.astro';
import CallToAction from '../../components/CallToAction.astro';
---

<Layout
	title="Online Advertising | Dave Palmer Marketing"
	description="Online advertising strategy and management for small businesses and organizations."
>
	<BannerHero
	image="/images/Marketing-page-1200x509-lr.jpg"
	heading="Marketing & Branding"
	description="Many organizations don't need more marketing tactics. They need clarity about what matters most and how to turn plans into action."
	contentPosition="right"
/>

        <ContentSection
	heading="Stop Guessing. Start Prioritizing."
	lead="Marketing consulting that helps organizations prioritize their marketing, strengthen their brand, and move forward with confidence."
	paragraphs={[
		"Many organizations don't struggle because they lack ideas. They struggle because they lack clear priorities.",
		'I help organizations identify priorities, clarify positioning, strengthen brands, and create practical marketing plans that can actually be implemented.',
		'Services include:'
	]}
	items={[
	'Marketing Strategy',
	'Marketing Plans',
	'Brand Positioning',
	'Brand Refreshes',
	'Marketing Audits',
	'Marketing Campaign Planning',
	'Marketing Content Development',
	'Strategic Planning Sessions'
]}

/>

<CallToAction
	heading="Experienced Marketing Leadership When You Need It"
	paragraphs={[
		'Not every organization needs a full-time marketing department. Sometimes you simply need an experienced marketing professional to help clarify priorities, solve challenges, and keep important projects moving.',
		"Whether you're developing a marketing strategy, refreshing your brand, launching a campaign, or simply looking for a second opinion, I provide practical marketing support that helps turn ideas into action and measurable results."
	]}
/>

</Layout>
