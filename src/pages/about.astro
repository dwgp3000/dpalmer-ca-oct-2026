---
import Layout from '../layouts/Layout.astro';
import BannerHero from '../components/BannerHero.astro';
import ContentSection from '../components/ContentSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';

import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';

const builder = createImageUrlBuilder(sanityClient);

function urlFor(source) {
	return builder.image(source);
}

const aboutPage = await sanityClient.fetch(
	`*[_type == "aboutPage"][0]{
		heroHeading,
		heroDescription,
		heroImage,
		heroContentPosition,

		contentSections[]{
			heading,
			lead,
			contentType,
			paragraphs,
			items,
			richText,
			showDeliverables,
			closingText
		},

		featureGridHeading,

		features[]{
			title,
			icon,
			description
		},

		seo {
			metaTitle,
			metaDescription
		}
	}`
);

const heroImageUrl = aboutPage.heroImage
	? urlFor(aboutPage.heroImage)
			.width(1600)
			.height(680)
			.fit('crop')
			.quality(85)
			.auto('format')
			.url()
	: '/images/about-page-1200x509-lr.jpg';
---

<Layout
	title={aboutPage.seo.metaTitle}
	description={aboutPage.seo.metaDescription}
>
	<BannerHero
		image={heroImageUrl}
		heading={aboutPage.heroHeading}
		description={aboutPage.heroDescription}
		contentPosition={aboutPage.heroContentPosition}
	/>

	{aboutPage.contentSections.map((section) => (
		<ContentSection
			heading={section.heading}
			lead={section.lead}
			contentType={section.contentType}
			paragraphs={section.paragraphs}
			items={section.items}
			richText={section.richText}
			closingText={section.closingText}
		/>
	))}

	<FeatureGrid
		heading={aboutPage.featureGridHeading}
		features={aboutPage.features}
	/>
</Layout>