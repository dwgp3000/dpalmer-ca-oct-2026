---
interface Props {
	heading: string;
	lead?: string;
	paragraphs?: string[];
	items?: string[];
	closingText?: string;
}

const {
	heading,
	lead,
	paragraphs = [],
	items = [],
	closingText
} = Astro.props;
---

<section class="content-section">
	<div class="container">
		<div class="content-section-inner">

			<h2>{heading}</h2>
			{lead && (
	<p class="lead-paragraph">{lead}</p>
)}

			{paragraphs.map((paragraph) => (
				<p>{paragraph}</p>
			))}

			{items.length > 0 && (
				<div class="row content-section-list">
					{items.map((item) => (
						<div class="col-md-6">
							<ul>
								<li>{item}</li>
							</ul>
						</div>
					))}
				</div>
			)}

			{closingText && (
	<p class="content-section-closing">{closingText}</p>
)}

		</div>
	</div>
</section>