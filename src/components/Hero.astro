---
interface Props {
	heading: string;
	paragraphs?: string[];
	buttonText?: string;
	buttonLink?: string;
	image: string;
	imageAlt?: string;
}

const {
	heading,
	paragraphs = [],
	buttonText = 'Book a Free Consultation',
	buttonLink = '/contact',
	image,
	imageAlt = 'Portrait of Dave Palmer'
} = Astro.props;
---

<section class="home-hero">
	<div class="container">
		<h1 class="home-hero-title animate-heading">
			{heading.split('\n').map((line, index) => (
				<>
					{line}
					{index < heading.split('\n').length - 1 && <br />}
				</>
			))}
		</h1>

		<div class="row align-items-end">
			<div class="col-lg-7">
				<div class="home-hero-copy">
					{paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}

					{buttonText && (
						<a class="btn dp-primary-button" href={buttonLink}>
							{buttonText}
						</a>
					)}
				</div>
			</div>

			<div class="col-lg-5">
				<div class="home-hero-image">
					<img
						src={image}
						alt={imageAlt}
					/>
				</div>
			</div>
		</div>
	</div>
</section>