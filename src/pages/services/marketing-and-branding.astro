---
import Layout from '../../layouts/Layout.astro';
import BannerHero from '../../components/BannerHero.astro';
import ContentSection from '../../components/ContentSection.astro';
import CallToAction from '../../components/CallToAction.astro';
import StructuredData from '../../components/StructuredData.astro';

import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';

const builder = createImageUrlBuilder(sanityClient);

function urlFor(source) {
	return builder.image(source);
}

const service = await sanityClient.fetch(
	`*[_type == "service" && slug.current == "services/marketing-and-branding"][0]{
		title,
		shortDescription,
		heroHeading,
		heroDescription,
		heroContentPosition,
		heroImage,
		contentSections[]{
			heading,
			lead,
			paragraphs,
			showDeliverables,
			closingText
		},
		deliverables,
		ctaHeading,
		ctaParagraphs,
		ctaButtonText,
		seo {
			metaTitle,
			metaDescription
		}
	}`
);

const heroImageUrl = service.heroImage
	? urlFor(service.heroImage)
			.width(1600)
			.height(680)
			.fit('crop')
			.quality(85)
			.auto('format')
			.url()
	: '/images/Marketing-page-1200x509-lr.jpg';
---

<Layout
	title={service.seo.metaTitle}
	description={service.seo.metaDescription}
>
	<StructuredData
		name="Dave Palmer Marketing"
		serviceName={service.title}
		url="https://dpalmer.ca/services/marketing-and-branding/"
		description={service.seo.metaDescription}
		deliverables={service.deliverables}
	/>

	<BannerHero
		image={heroImageUrl}
		heading={service.heroHeading}
		description={service.heroDescription}
		contentPosition={service.heroContentPosition}
	/>

	{service.contentSections.map((section) => (
		<ContentSection
			heading={section.heading}
			lead={section.lead}
			paragraphs={section.paragraphs}
			items={section.showDeliverables ? service.deliverables : []}
			closingText={section.closingText}
		/>
	))}

	<CallToAction
		heading={service.ctaHeading}
		paragraphs={service.ctaParagraphs}
		buttonText={service.ctaButtonText}
	/>
</Layout>