---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page Not Found | Dave Palmer Marketing"
	description="Thanks for visiting.The page you're looking for could not be found."
>
	<section class="content-section">
		<div class="container">
			<div class="content-section-inner">
				<h1>Page Not Found</h1>

				<p class="lead-paragraph">
					Thanks for visiting. The page you're looking for doesn't exist or may have moved.
				</p>

				<a class="btn dp-primary-button" href="/">
					Return to Home
				</a>
			</div>
		</div>
	</section>
</Layout>