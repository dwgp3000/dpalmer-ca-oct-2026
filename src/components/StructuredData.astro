---
const {
	type = "ProfessionalService",
	name = "Dave Palmer Marketing",
	serviceName,
	url = "https://dpalmer.ca",
	description,
	deliverables = [],
} = Astro.props;

const schema = {
	"@context": "https://schema.org",
	"@type": type,
	name,
	url,
	description,

	...(serviceName && {
		hasOfferCatalog: {
			"@type": "OfferCatalog",
			name: `${serviceName} Services`,
			itemListElement: deliverables.map((item) => ({
				"@type": "Offer",
				itemOffered: {
					"@type": "Service",
					name: item,
				},
			})),
		},
	}),
};
---

<script
	type="application/ld+json"
	set:html={JSON.stringify(schema)}
></script>