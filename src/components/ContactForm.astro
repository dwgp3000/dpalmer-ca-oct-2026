<form
	class="contact-form"
	action="https://formspree.io/f/xeaopdqk"
	method="POST"
>
	<div class="contact-form-field">
		<label for="name">Name</label>
		<input
			id="name"
			name="name"
			type="text"
			placeholder="First & Last Name"
			autocomplete="name"
			required
		/>
	</div>

	<div class="contact-form-field">
		<label for="email">Email Address</label>
		<input
			id="email"
			name="email"
			type="email"
			placeholder="Email Address"
			autocomplete="email"
			required
		/>
	</div>

	<div class="contact-form-field">
		<label for="message">What would you like help with?</label>
		<textarea
			id="message"
			name="message"
			placeholder="Tell me a little about your project, challenge, or marketing goals."
			rows="4"
			required
		></textarea>
	</div>

	<button class="contact-form-button" type="submit">
		Submit
	</button>
</form>