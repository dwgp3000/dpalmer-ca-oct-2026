---
import Layout from '../../layouts/Layout.astro';
import BannerHero from '../../components/BannerHero.astro';
import ContentSection from '../../components/ContentSection.astro';
import CardGrid from '../../components/CardGrid.astro';
import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';

const builder = createImageUrlBuilder(sanityClient);

const servicesPage = await sanityClient.fetch(
	`*[_type == "servicesPage"][0]{
		heroHeading,
		heroDescription,
		heroImage,
		heroContentPosition,

		contentHeading,
		contentLead,
		contentParagraphs,

		servicesHeading,

		featuredServices[]->{
			title,
			shortDescription,
			slug,
			icon
		},

		seo {
			metaTitle,
			metaDescription
		}
	}`
);

const heroImageUrl = servicesPage?.heroImage
	? builder.image(servicesPage.heroImage).width(1600).url()
	: '/images/Services-page-1200x509-lr.jpg';

const services = servicesPage?.featuredServices?.map((service) => ({
	title: service.title,
	description: service.shortDescription,
	href: `/services/${service.slug.current}/`,
	icon: service.icon
})) ?? [];
---

<Layout
	title={servicesPage?.seo?.metaTitle}
	description={servicesPage?.seo?.metaDescription}
>
	<BannerHero
		image={heroImageUrl}
		heading={servicesPage.heroHeading}
		description={servicesPage.heroDescription}
		contentPosition={servicesPage.heroContentPosition}
	/>

	<ContentSection
		heading={servicesPage.contentHeading}
		lead={servicesPage.contentLead}
		paragraphs={servicesPage.contentParagraphs ?? []}
	/>

	<CardGrid
		heading={servicesPage.servicesHeading}
		columns={3}
		cards={services}
	/>
</Layout>