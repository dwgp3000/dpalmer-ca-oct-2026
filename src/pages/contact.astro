---
import Layout from '../layouts/Layout.astro';
import BannerHero from '../components/BannerHero.astro';
import ContactForm from '../components/ContactForm.astro';
import CardGrid from '../components/CardGrid.astro';

import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';

const builder = createImageUrlBuilder(sanityClient);

function urlFor(source) {
	return builder.image(source);
}

const contactPage = await sanityClient.fetch(
	`*[_type == "contactPage"][0]{
		heroHeading,
		heroDescription,
		heroImage,
		heroContentPosition,

		contactHeading,
		contactParagraphs,

		servicesHeading,

		featuredServices[]->{
			title,
			shortDescription,
			"href": "/" + slug.current + "/",
			icon
		},

		seo {
			metaTitle,
			metaDescription
		}
	}`
);

const heroImageUrl = contactPage.heroImage
	? urlFor(contactPage.heroImage)
			.width(1600)
			.height(680)
			.fit('crop')
			.quality(85)
			.auto('format')
			.url()
	: '/images/contact-page-1200x509-lr.jpg';

const services = contactPage.featuredServices?.map((service) => ({
	title: service.title,
	description: service.shortDescription,
	href: service.href,
	icon: service.icon
})) ?? [];
---

<Layout
	title={contactPage.seo.metaTitle}
	description={contactPage.seo.metaDescription}
>
	<BannerHero
		image={heroImageUrl}
		heading={contactPage.heroHeading}
		description={contactPage.heroDescription}
		contentPosition={contactPage.heroContentPosition}
	/>

	<section class="content-section contact-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10">
					<h2>{contactPage.contactHeading}</h2>

					{contactPage.contactParagraphs?.map((paragraph) => (
						<p>{paragraph}</p>
					))}

					<div class="contact-form-wrapper">
						<ContactForm />
					</div>
				</div>
			</div>
		</div>
	</section>

	<CardGrid
		heading={contactPage.servicesHeading}
		columns={3}
		cards={services}
	/>
</Layout>