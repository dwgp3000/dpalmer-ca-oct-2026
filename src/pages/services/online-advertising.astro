---
import Layout from '../../layouts/Layout.astro';
import BannerHero from '../../components/BannerHero.astro';
import ContentSection from '../../components/ContentSection.astro';
import CallToAction from '../../components/CallToAction.astro';
import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';
import StructuredData from '../../components/StructuredData.astro';

const builder = createImageUrlBuilder(sanityClient);

function urlFor(source) {
	return builder.image(source);
}

const service = await sanityClient.fetch(
	`*[_type == "service" && slug.current == "services/online-advertising"][0]{
		title,
		heroHeading,
		heroDescription,
		heroContentPosition,
		heroImage,
		deliverables,
		ctaHeading,
        ctaParagraphs,
        ctaButtonText,
		seo {
			metaTitle,
			metaDescription
		}
	}`
);

const heroImageUrl = service.heroImage
	? urlFor(service.heroImage)
			.width(1600)
			.height(680)
			.fit('crop')
			.quality(85)
			.auto('format')
			.url()
	: '/images/Online-ads-page-1200x509-lr.jpg';

	
---

<Layout
	title={service.seo.metaTitle}
	description={service.seo.metaDescription}
>
<StructuredData
	name="Dave Palmer Marketing"
	serviceName={service.title}
	url="https://dpalmer.ca/services/online-advertising/"
	description={service.seo.metaDescription}
	deliverables={service.deliverables}
/>

	<BannerHero
	image={heroImageUrl}
	heading={service.heroHeading}
	description={service.heroDescription}
	contentPosition={service.heroContentPosition}
/>

        <ContentSection
	heading="Let's Start Advertising"
	lead="Successful online advertising starts with a clear strategy. I help organizations plan, launch, manage, and improve online advertising across platforms such as Google and Meta (Facebook and Instagram)."
	paragraphs={[
		'This includes campaign setup, testing, optimization, reporting, and coordination with landing pages or website content.',
		'Services include:'
	]}
	items={service.deliverables}

	closingText="Most advertising work is managed monthly. In select cases, particularly for e-commerce or clearly defined lead generation, performance-based pricing may be considered when tracking and control requirements are met."
/>
<CallToAction
	heading={service.ctaHeading}
	paragraphs={service.ctaParagraphs}
	buttonText={service.ctaButtonText}
/>

</Layout>
