---
interface Props {
	heading?: string;
	description?: string;
	linkedinUrl?: string;
	copyrightText?: string;
}

const {
	heading = 'DAVE PALMER MARKETING',
	description = 'Helping small businesses and organizations turn marketing plans into practical action and measurable results.',
	linkedinUrl = 'https://www.linkedin.com/in/davewpalmer/',
	copyrightText = 'Dave Palmer Marketing'
} = Astro.props;
---<footer class="site-footer">
	<div class="container">
		<div class="footer-inner">

			<div class="row gy-4">
				<div class="col-md-5 footer-about">
					<h2 class="footer-heading">{heading}</h2>

					<p class="footer-description">
	{description}
</p>
				</div>

				<div class="col-md-3">
					<nav class="footer-nav" aria-label="Footer navigation">
						<a href="/">Home</a>
						<a href="/services/online-advertising/">Online Advertising</a>
						<a href="/services/websites/">Websites</a>
						<a href="/services/marketing-and-branding/">Marketing & Branding</a>
						<a href="/about/">About</a>
						<a href="/contact/">Contact</a>
					</nav>
				</div>

				<div class="col-md-4">
					<div class="footer-brand-row">
						<a
							class="footer-linkedin"
							href={linkedinUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Dave Palmer on LinkedIn"
						>
							in
						</a>

						<a class="footer-brand" href="/" aria-label="Dave Palmer Marketing home">
	<img
		src="/images/dp-marketing-logo-horz.svg"
		alt="Dave Palmer Marketing"
		class="footer-brand-logo"
	/>
</a>
					</div>
				</div>
			</div>

			<p class="footer-copyright">
	© {new Date().getFullYear()} {copyrightText}
</p>

		</div>
	</div>
</footer>