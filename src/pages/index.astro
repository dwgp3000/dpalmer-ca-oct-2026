---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardGrid from '../components/CardGrid.astro';
import ContentSection from '../components/ContentSection.astro';
import CallToAction from '../components/CallToAction.astro';
import { services } from '../data/services';

---

<Layout
	title="Dave Palmer Marketing | Regina Marketing, Advertising & Websites"
	description="Marketing services for small businesses and organizations, including strategy, advertising and website development."
>
	<Hero />

	<CardGrid
	heading="SERVICES"
	columns={3}
	cards={services}
/>

<ContentSection
	heading="Senior Marketing Support Without the Overhead"
	paragraphs={[
		"Small organizations often don't have a full-time marketing department, but they still need experienced marketing leadership.",
		"For more than 30 years, I've helped businesses, nonprofits, and membership organizations solve marketing challenges through strategy, branding, websites, advertising, and communications.",
		"I provide senior-level marketing support without the cost of a full marketing department, combining practical advice, hands-on execution, and a focus on measurable results."
	]}
	items={[
		'30+ years of experience',
		'Strategy and execution',
		'Branding and positioning',
		'Website planning and development',
		'Digital advertising and SEO',
		'Project and stakeholder leadership',
		'Agency and in-house experience',
		'Practical, no-nonsense advice'
	]}
/><CallToAction
	heading="Let's Talk About Your Marketing"
	text="Whether you need a website, advertising support, strategic direction, or simply a second opinion, I'd be happy to discuss your goals."
/>
</Layout>